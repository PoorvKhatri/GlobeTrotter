# ---- MongoDB ----
# Local:  mongodb://127.0.0.1:27017/globetrotter
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/globetrotter?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/globetrotter

# ---- Auth ----
# Generate a strong secret, e.g.  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ---- App ----
NEXT_PUBLIC_APP_NAME=GlobeTrotter
NEXT_PUBLIC_APP_URL=http://localhost:3000
